# These must be passed to your process. The application does not auto-load .env files.
EVOLVE_DB=data/evolve.db
# Use true with HTTPS in a deployment; false for localhost HTTP.
EVOLVE_SECURE_COOKIES=false
# Optional exact HTTPS origin(s) if a trusted reverse proxy changes the internal URL.
# Never use a wildcard. Same-origin requests work without this setting.
EVOLVE_ORIGINS=
# Generate a private random secret of at least 32 bytes. Required for HTTPS.
# Local HTTP development generates a persistent random signing key in SQLite.
EVOLVE_JWT_SECRET=
# Optional Google OAuth web-client settings. Use the same browser hostname.
EVOLVE_GOOGLE_CLIENT_ID=
EVOLVE_GOOGLE_CLIENT_SECRET=
EVOLVE_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
