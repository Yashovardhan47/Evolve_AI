# These must be passed to your process. The application does not auto-load .env files.
EVOLVE_DB=data/evolve.db
# Use true with HTTPS in a deployment; false for localhost HTTP.
EVOLVE_SECURE_COOKIES=false
# Optional exact HTTPS origin(s) if a trusted reverse proxy changes the internal URL.
# Never use a wildcard. Same-origin requests work without this setting.
EVOLVE_ORIGINS=
